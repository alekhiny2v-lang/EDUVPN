<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions.

      The VPN service itself is NOT declared here. `de.blinkt.openvpn.core.OpenVPNService`
      lives in the vendored ics-openvpn library module and its own manifest already
      declares it with `android:permission="android.permission.BIND_VPN_SERVICE"` and
      `android:foregroundServiceType="specialUse"`; the manifest merger folds that into
      this app. Re-declaring it here would only risk the two definitions drifting apart.

      Android never needs a runtime permission for the tunnel itself - the
      `VpnService.prepare()` consent dialog in MainActivity is the gate.
    -->

    <!-- Fetching the VPN Gate server list. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The OpenVPN tunnel runs as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ics-openvpn declares its service as specialUse; API 34+ needs the matching permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The tunnel is only visible to the user through its notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared by ics-openvpn on Android 16 so it can reach a LAN-side relay. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".EdUvpnApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_vpn"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EDUVPN"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EDUVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
