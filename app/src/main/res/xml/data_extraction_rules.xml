<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores ics-openvpn profiles (which contain a client key) in its private
  data directory. Excluding them from backup and device transfer keeps those
  keys from ending up in a cloud backup or on a second device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
