<?xml version="1.0" encoding="utf-8"?>
<!--
  One-tap VPN screen.

  Single round Connect/Disconnect button, a status line, and a country + ping
  line. The button colour is driven from MainActivity via backgroundTintList so
  state changes do not need extra drawables.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:padding="@dimen/screen_padding"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/app_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/app_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitle" />

    <!-- The prominent round button. cornerRadius == half the width makes it a circle. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/connectButton"
        android:layout_width="@dimen/power_button_size"
        android:layout_height="@dimen/power_button_size"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:text="@string/action_connect"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/button_label"
        app:backgroundTint="@color/button_idle"
        app:cornerRadius="@dimen/power_button_radius"
        app:elevation="@dimen/power_button_elevation"
        app:icon="@drawable/ic_power"
        app:iconGravity="textStart"
        app:iconSize="@dimen/power_icon_size"
        app:iconTint="@color/button_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:rippleColor="@color/button_ripple"
        tools:text="Connect" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/accent"
        app:indicatorSize="@dimen/progress_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectButton"
        app:trackThickness="@dimen/progress_thickness"
        tools:visibility="visible" />

    <!-- "Idle" / "Fetching best server…" / "Connecting…" / "Connected" -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:gravity="center"
        android:text="@string/status_idle"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator"
        tools:text="Fetching best server…" />

    <!-- "Japan (JP)" -->
    <TextView
        android:id="@+id/countryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        tools:text="Japan (JP)"
        tools:visibility="visible" />

    <!-- "10 ms · 219.100.37.9:443 · TCP" -->
    <TextView
        android:id="@+id/detailText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/countryText"
        tools:text="10 ms · 219.100.37.9:443 · TCP"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/legalText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/legal_note"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
